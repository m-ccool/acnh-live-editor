# Optional local-only settings for remote Steam Deck deploys from Windows.
# Copy to .steamdeck-deploy.env if you want stable values without passing flags.

# Optional explicit Deck SSH target. If omitted, the deploy script will try to
# infer the current bridge client IP from http://10.0.0.25:3000/api/bridge/status.
# STEAMDECK_SSH_HOST=10.0.0.233

STEAMDECK_SSH_USER=deck
STEAMDECK_SSH_PORT=22
STEAMDECK_REPO_DIR=~/acnh-live-editor
STEAMDECK_REPO_BRANCH=dev
STEAMDECK_BRIDGE_PROCESS_MATCH=scripts/steamdeck-bridge-client.js
STEAMDECK_BRIDGE_START_COMMAND=bash scripts/steamdeck-run-bridge.sh

# Optional SSH identity file on Windows.
# STEAMDECK_SSH_KEY=C:/Users/mccoo/.ssh/id_ed25519