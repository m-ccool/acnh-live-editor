{
  "name": "acnh-live-editor",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "dev:watch": "nodemon --watch server.js --watch modules/ --watch public/ server.js",
    "prestart": "node --check server.js && node --check modules/bridgeService.js && node --check modules/apiRouter.js",
    "start": "node server.js",
    "verify:bridge-backend": "node scripts/verify-bridge-backend.js",
    "deploy:steamdeck": "powershell -ExecutionPolicy Bypass -File scripts/deploy-steamdeck-bridge.ps1 -RestartBridge",
    "sync:react-runtime": "node scripts/sync-react-runtime.js",
    "import:catalogue": "node scripts/import-catalogue.js",
    "sync:nookipedia": "node scripts/sync-nookipedia-catalog.js",
    "bridge:steamdeck": "node scripts/steamdeck-bridge-client.js",
    "steamdeck:install": "bash scripts/install-steamdeck-launcher.sh",
    "steamdeck:launch": "bash scripts/steamdeck-launch-app.sh",
    "steamdeck:steam-library": "bash scripts/register-steam-library-shortcut.sh",
    "bridge:adapter:game": "node scripts/steamdeck-adapters/read-game-data.js",
    "bridge:adapter:read": "node scripts/steamdeck-adapters/read-inventory.js",
    "bridge:adapter:write": "node scripts/steamdeck-adapters/write-inventory-slot.js"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
