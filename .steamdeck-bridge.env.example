# Copy this file to .steamdeck-bridge.env on Steam Deck and edit values.
# Same-deck mode (Steam Deck runs UI + bridge + game):
# SAME_DECK_MODE=1
# BRIDGE_TARGET_HOST=127.0.0.1
# BRIDGE_TARGET_PORT=32840

# Cross-machine mode (Steam Deck bridge -> Windows host):
# SAME_DECK_MODE=0
BRIDGE_TARGET_HOST=10.0.0.25
BRIDGE_TARGET_PORT=32840
ACNH_READER_MODE=procmem

# Optional bridge client overrides
# BRIDGE_DEVICE_NAME=steamdeck-bridge-client
# BRIDGE_HEARTBEAT_MS=5000
# BRIDGE_RECONNECT_DELAY_MS=3000
# BRIDGE_COMMAND_TIMEOUT_MS=5000
# RYUJINX_PROCESS_MATCH=ryujinx
# RYUJINX_STRICT_PROCESS_CHECK=1

# Default live commands already point at the in-repo bridge memory tool.
# Override only if you need a custom wrapper:
# RYUJINX_READ_INVENTORY_CMD="python3 scripts/steamdeck-adapters/bridge_memory_tool.py read_inventory"
# RYUJINX_WRITE_INVENTORY_CMD="python3 scripts/steamdeck-adapters/bridge_memory_tool.py write_inventory_slot"
# RYUJINX_READ_GAME_DATA_CMD="python3 scripts/steamdeck-adapters/bridge_memory_tool.py read_game_data"

# Optional direct reader overrides used by bridge_memory_tool.py.
# Leave unset to use the in-repo acnh_memory_reader.py.
# RYUJINX_LIVE_READ_INVENTORY_CMD="python3 /home/deck/acnh-live-editor/scripts/steamdeck-adapters/acnh_memory_reader.py read_inventory"
# RYUJINX_LIVE_WRITE_INVENTORY_CMD="python3 /home/deck/acnh-live-editor/scripts/steamdeck-adapters/acnh_memory_reader.py write_inventory_slot"
# RYUJINX_LIVE_READ_GAME_DATA_CMD="python3 /home/deck/acnh-live-editor/scripts/steamdeck-adapters/acnh_memory_reader.py read_game_data"

# Optional proc-mem calibration overrides for acnh_memory_reader.py.
# ACNH_RYUJINX_PID=12345
# ACNH_DRAM_OFFSET=0x7f0000000000
# ACNH_GAME_VERSION=2.0.7
# ACNH_INVENTORY_SLOT1_OFFSET=0xAFB1E6E0
# ACNH_INVENTORY_SLOT21_OFFSET=0xAFB1E628
# ACNH_PLAYER_NAME_OFFSET=0xAFBC6400
# ACNH_PLAYER_TOWN_OFFSET=0xAFBC6600
# ACNH_PLAYER_WALLET_OFFSET=0xAFBC6510
# ACNH_PLAYER_BANK_OFFSET=0xAFBC6514
# ACNH_PLAYER_MILES_OFFSET=0xAFBC6518
